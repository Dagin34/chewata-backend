# MongoDB Atlas URI
MONGODB_URI=""

# Other Development Variables
PORT="5200"

# Generate a strong random value, e.g. `openssl rand -base64 32` — never reuse
# across environments and never commit the real value.
JWT_SECRET=""

# Must be "development" locally and exactly "production" when deployed.
# This is not just cosmetic: the auth cookie's SameSite/Secure attributes
# (see src/lib/utils.js) are derived from this value. If it's left unset on
# your host (many platforms, including Render, do NOT set NODE_ENV
# automatically), the cookie is issued as SameSite=Strict and browsers will
# silently drop it on cross-site requests between a separately-hosted
# frontend and this API — every request after login will 401 with
# "Unauthorized - No Token Provided!".
NODE_ENV="development"

# Cloudinary related keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
